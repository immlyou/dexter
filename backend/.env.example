# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dexter

# JWT (required; server refuses to start with missing/short/example values)
# Generate each with: openssl rand -base64 48   (must be >=32 bytes and differ from each other)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# LLM API Keys (from parent project)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FINANCIAL_DATASETS_API_KEY=
EXASEARCH_API_KEY=
