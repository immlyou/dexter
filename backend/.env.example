# Server
PORT=3000
NODE_ENV=development

# Database
# docker-compose requires POSTGRES_PASSWORD (URL-safe, e.g. openssl rand -hex 24) and builds
# the API's DATABASE_URL from it. For running the API outside compose, set DATABASE_URL directly.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://dexter:<password>@localhost:5432/dexter

# JWT (required; server refuses to start with missing/short/example values)
# Generate each with: openssl rand -base64 48   (must be >=32 bytes and differ from each other)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Proxy / rate limits
# Number of trusted reverse proxies appending to X-Forwarded-For (0 = use the socket
# peer address). The client IP is the N-th entry from the right. Legacy TRUST_PROXY=1 = 1 hop.
TRUST_PROXY_HOPS=0
# docker-compose: host address the API port is published on (default loopback only)
# API_BIND_ADDRESS=127.0.0.1
# API_PORT=8000
# Optional overrides (defaults shown)
# RATE_LIMIT_LOGIN_PER_IP=20
# RATE_LIMIT_LOGIN_PER_ACCOUNT=10
# RATE_LIMIT_REGISTER_PER_IP=5
# RATE_LIMIT_QUERY_PER_USER=30
# RATE_LIMIT_QUERY_PER_IP=60
# MAX_CONCURRENT_QUERIES_PER_USER=2
# QUERY_TIMEOUT_MS=600000
# REFRESH_REUSE_GRACE_SECONDS=20
# REVOKED_TOKEN_RETENTION_SECONDS=604800

# Runtime data (scratchpads, API cache); must be writable. Defaults to ./.dexter
# DEXTER_DATA_DIR=
# Container only: run migrations at start (default 1)
# RUN_MIGRATIONS=1

# LLM API Keys (from parent project)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
FINANCIAL_DATASETS_API_KEY=
EXASEARCH_API_KEY=
TAVILY_API_KEY=
